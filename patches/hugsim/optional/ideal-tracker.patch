+def ideal_step(env, plan_traj, dt):
+    """jev-drive ideal tracker (patches/hugsim/optional/ideal-tracker.patch), replacing traj2control + iLQR: the ego
+    moves exactly along the plan for one step, on the quadratic p(t) = qa t + qb t^2 through the origin and the first
+    two waypoints (t = 0.5, 1.0 s), ending with the heading and speed of p'(dt). The env is the installed HUGSimEnv,
+    unchanged: its bicycle step with zero control moves the ego by velo * dt along its heading and turns it by
+    velo * tan(steer) / L * dt, so heading, speed and steer are set just before it to land on the target, and the
+    speed and steer after it are the plan's. Collisions, route checks, actors and rendering run as in the env."""
+    e = env.unwrapped
+    plan = np.asarray(plan_traj, dtype=np.float64)
+    p1 = plan[0]
+    p2 = plan[1] if len(plan) > 1 else 2 * p1
+    qa, qb = 4 * p1 - p2, 2 * (p2 - 2 * p1)
+    pos, vel = qa * dt + qb * dt ** 2, qa + 2 * qb * dt          # ego frame of this step: x right, y forward
+    v = float(np.linalg.norm(vel))
+    dth = float(np.arctan2(vel[0], vel[1])) if v > 1e-6 else 0.0
+    L = e.kinematic['Lr'] + e.kinematic['Lf']
+    theta, v_prev = float(e.vr[1]), float(e.velo)
+    chord = float(np.linalg.norm(pos))
+    th_chord = theta + (float(np.arctan2(pos[0], pos[1])) if chord > 1e-9 else 0.0)
+    e.vr[1] = th_chord
+    e.velo = chord / dt
+    e.steer = float(np.arctan((theta + dth - th_chord) * L / chord)) if chord > 1e-9 else 0.0
+    obs, reward, terminated, truncated, info = env.step({'acc': 0.0, 'steer_rate': 0.0})
+    e.velo = v
+    e.steer = float(np.arctan(L * dth / (v * dt))) if v > 1e-6 else 0.0
+    info['ego_velo'], info['ego_steer'] = e.velo, e.steer
+    info['accelerate'] = e.last_accel = (v - v_prev) / dt
+    info['steer_rate'] = e.last_steer_rate = 0.0
+    return obs, reward, terminated, truncated, info
+
+
